# Local state — never commit real state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Variables files with secrets — commit .tfvars.example instead
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Terragrunt's per-unit copy of the source module it runs against
.terragrunt-cache/

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Credentials
.aws/
*.pem
*.key

# kubeadm join command fetched locally by the k8s-controlplane module
.join_command.*.txt

__pycache__/
.pytest_cache/
*.pyc
